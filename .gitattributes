# Only track truly large Unity assets that exceed GitHub's limits
# Most Unity config assets are small and don't need LFS

# 3D models (usually large)
*.fbx filter=lfs diff=lfs merge=lfs -text

# Specific large font assets (over 100MB)
**/createdFontAssets/*.asset filter=lfs diff=lfs merge=lfs -text

